# One file per NBFC: /etc/nginx/sites-available/lms-__CODE__.conf
# Generated by deploy/scripts/new-tenant.sh. Every tenant serves the same frontend build;
# only the backend port (and so the database) differs.

server {
    listen 80;
    server_name __DOMAIN__;

    client_max_body_size 20m;

    # Shared React build (npm run build in frontend/, built with VITE_API_URL=/backend).
    root __APP_DIR__/frontend/dist;
    index index.html;

    # API for this NBFC. The trailing slash strips the /backend prefix before proxying.
    location /backend/ {
        proxy_pass http://127.0.0.1:__PORT__/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location / {
        try_files $uri /index.html;
    }

    location ~* \.(js|css|png|jpg|svg|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
}
