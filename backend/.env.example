# Copy to backend/.env for local development.
# In production each NBFC gets its own file (e.g. /etc/lms/tenants/<code>.env) passed via ENV_FILE.

PORT=3000
# Comma-separated origins allowed to call the API. Leave empty only for local development.
CORS_ORIGINS=

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=loan_management

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
ANNUAL_INTEREST_RATE=12

# 32-byte (64 hex chars) key. Encrypts provider secrets and customer PAN. Never change it after go-live,
# or existing encrypted values become unreadable. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=

# Local folder for uploaded/generated files (one folder per NBFC instance).
STORAGE_PATH=./storage

# Nightly job (00:30 IST) that marks overdue EMIs. Set to false to disable.
ENABLE_SCHEDULER=true
# Maker-checker: the staff member who created an application cannot approve it.
MAKER_CHECKER_ENABLED=true
# Accept unsigned mock provider/payment webhooks. NEVER enable in production: the mock signature is public,
# so anyone could complete disbursements or mark EMIs paid. Staff confirm these steps from the UI instead.
ALLOW_MOCK_WEBHOOKS=false

# ---- Tenant onboarding (read by `npm run tenant:init`) ----
TENANT_ORG_CODE=DEMO
TENANT_ORG_NAME=Demo Finance
TENANT_ORG_LEGAL_NAME=Demo Finance Private Limited
TENANT_RBI_REGISTRATION=
TENANT_SUPPORT_EMAIL=
TENANT_SUPPORT_PHONE=
# Your (vendor) account. Hidden from the NBFC's staff list; cannot be edited by NBFC admins.
SUPER_ADMIN_NAME=Platform Support
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# The NBFC's first administrator.
NBFC_ADMIN_NAME=
NBFC_ADMIN_EMAIL=
NBFC_ADMIN_PHONE=
NBFC_ADMIN_PASSWORD=

# ---- Providers (leave empty to run in mock mode) ----
# Set EASEBUZZ_ENV=production only with live keys.
EASEBUZZ_ENV=sandbox
EASEBUZZ_KEY=
EASEBUZZ_SALT=
DIGIO_CLIENT_ID=
DIGIO_CLIENT_SECRET=
DOQUFY_API_KEY=
